<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SmartNPC SMAPI Mod (M2 minimal: HTTP endpoint + HUD message).

    Dependencies:
      - Pathoschild.Stardew.ModBuildConfig: auto-discovers SDV install path
        and references SMAPI / SDV / XNA assemblies. Also auto-deploys the
        built mod to <SDV>/Mods/<ModName>/ when EnableModDeploy is true.

    If ModBuildConfig cannot find your SDV install, set SMARTNPC_GAME_PATH
    in the repo-root .env file (see .env.example).
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>SmartNPC.Bridge</RootNamespace>
    <AssemblyName>StardewMCPBridge</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableModDeploy>true</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <!-- Reference 0Harmony.dll shipped with SMAPI (needed for ChatInputCapture patch). -->
    <EnableHarmony>true</EnableHarmony>
    <!--
      GamePath resolution order:
        1. Explicit MSBuild property: `dotnet build /p:GamePath=...`
        2. Env var SMARTNPC_GAME_PATH (set in .env at repo root)
        3. Empty → ModBuildConfig auto-discovers standard Steam install paths
           (Windows / Linux / macOS). This is the common case; set the env
           var only if your SDV is in a non-default location.
    -->
    <GamePath Condition="'$(GamePath)' == '' AND '$(SMARTNPC_GAME_PATH)' != ''">$(SMARTNPC_GAME_PATH)</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="assets\xiami\XiaMi.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="assets\xiami\XiaMi_Portrait.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
