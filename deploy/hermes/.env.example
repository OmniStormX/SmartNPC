# SmartNPC Hermes Remote Deployment — Environment Variables
# Copy to .env and fill in actual values before running docker compose up.

# ─── MCP Connection (player side) ───────────────────────────────────────────
# Public IP or domain of the machine running smartnpc-mcp (the player's PC).
# Hermes gateways will call back to this address for MCP tool execution.
MCP_PUBLIC_HOST=your-mcp-public-ip-or-domain
MCP_PUBLIC_PORT=3000

# API key for authenticating MCP tool calls (must match --mcp-api-key on mcp side)
MCP_API_KEY=change-me-to-a-strong-random-key

# ─── Hermes Gateway Auth ────────────────────────────────────────────────────
# Bearer token that smartnpc-mcp uses when POSTing events to Hermes gateways.
# Must match SMARTNPC_HERMES_KEY in the player-side .env.
SMARTNPC_HERMES_KEY=smartnpc-test-key

# ─── LLM Provider ──────────────────────────────────────────────────────────
# The LLM API that Hermes profiles use for NPC decision-making.
HERMES_AGENT_URL=https://api.deepseek.com/v1
HERMES_AGENT_API_KEY=sk-your-api-key-here
HERMES_AGENT_MODEL=deepseek-v4-flash

# ─── Observability (optional) ──────────────────────────────────────────────
# Langfuse tracing. Leave empty to disable.
HERMES_LANGFUSE_PUBLIC_KEY=
HERMES_LANGFUSE_SECRET_KEY=
HERMES_LANGFUSE_BASE_URL=https://cloud.langfuse.com
