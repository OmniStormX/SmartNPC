# SmartNPC Hermes Remote Deployment
# 只需要这一个文件。复制为 .env 并填入实际值，然后 docker compose up -d。

# ─── 必填：MCP 连接（玩家侧 PC 的公网地址） ────────────────────────────
# Hermes 回调 MCP 工具时连接的地址。
# 格式: http://<玩家PC公网IP或域名>:<端口>/mcp
SMARTNPC_MCP_URL=http://your-public-ip:3000/mcp

# ─── 必填：Hermes Gateway 鉴权 ─────────────────────────────────────────
# smartnpc-mcp 向 Hermes POST 事件时的 Bearer token。
# 必须与玩家侧 --hermes-api-key 一致。
SMARTNPC_HERMES_KEY=smartnpc-test-key

# ─── 必填：LLM 供应商 ──────────────────────────────────────────────────
HERMES_AGENT_URL=https://api.deepseek.com/v1
HERMES_AGENT_API_KEY=sk-your-api-key-here
HERMES_AGENT_MODEL=deepseek-v4-flash

# ─── 可选：Langfuse 可观测性（留空则关闭） ─────────────────────────────
HERMES_LANGFUSE_PUBLIC_KEY=
HERMES_LANGFUSE_SECRET_KEY=
HERMES_LANGFUSE_BASE_URL=https://cloud.langfuse.com
