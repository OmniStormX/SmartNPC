# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work.sum
bin/
dist/

# IDE
.idea/
.vscode/
*.swp

# Env / secrets
.env
.env.local
langfuseAPI.md
*.local

# Hermes rendered profile artifacts (generated from _master/ at startup)
# Only SOUL.md is hand-written and tracked per NPC.
hermes/profiles/*/config-overlay.yaml
hermes/profiles/*/cron-recipes.md
hermes/profiles/*/skills/
!hermes/profiles/_master/skills/
!hermes/profiles/_master/skills/**
hermes/profiles/*/.env

# C# build outputs
smapi-mod/bin/
smapi-mod/obj/

# Sprite test crops (generated by crop_test.py)
smapi-mod/assets/xiami/test_crops/

# Taskfile runtime cache
.task/
# Go test build tmpdir (GOTMPDIR) — used by mcp:test to dodge WDAC on %TEMP%
.gotmp/
# Per-run mcp logs (run.bat redirects stderr here)
logs/
# Docker build context (generated by sync-profiles.sh)
deploy/hermes/profiles/
# Docker Compose generated by setup.bat (source: hermes/npcs.yaml)
deploy/hermes/docker-compose.yml
# Deploy .env generated by setup.bat from root .env
deploy/hermes/.env
# Claude Code (keep commands, ignore local settings)
.claude/settings.local.json

node_modules