@startuml
skinparam defaultFontSize 11
skinparam rectangleBorderThickness 2
skinparam packageBorderThickness 2

cloud "🌐 External LLM API\napi.deepseek.com/v1" as llm_api

rectangle "🖥️ Windows 主机" as win_host {
  rectangle "Stardew Valley + SMAPI" as game_box {
    mxgraph.networks.server "Mod WebSocket\nws://127.0.0.1:18745/ws" as ws_server
  }

  rectangle "smartnpc-mcp (Go)" as mcp_box {
    mxgraph.networks.server "MCP HTTP\n:3000/mcp" as mcp_http
    mxgraph.networks.server "Health Check\n:3000/healthz" as mcp_health
    mxgraph.networks.server "hermesrelay\n(outbound HTTP)" as relay
  }

  rectangle "Game Client" as client_box {
    mxgraph.networks.pc "SMAPI Console\n+ SmartNPC UI" as game_ui
  }
}

rectangle "🐧 WSL2 — Ubuntu-22.04" as wsl_host {
  rectangle "Docker Compose\n(smartnpc-net bridge)" as docker_net {
    mxgraph.networks.server "hermes-xiami\n:8642" as xiami
    mxgraph.networks.server "hermes-abigail\n:8643" as abigail
    mxgraph.networks.server "hermes-haley\n:8644" as haley
    mxgraph.networks.server "hermes-harvey\n:8645" as harvey
    mxgraph.networks.server "hermes-penny\n:8646" as penny
    mxgraph.networks.server "hermes-sebastian\n:8647" as sebastian
  }

  rectangle "Local Mode (alt)" as local_box {
    mxgraph.networks.server "hermes gateway\n(run --accept-hooks)\nper-profile process" as local_hermes
  }
}

' Intra-Windows connections
ws_server -- mcp_http : "ws JSON\nrequest/response/event"
mcp_http -- relay : "internal\nGo channel"
game_ui -- ws_server : "localhost"

' Windows → WSL (via WSL_IP)
relay ..> xiami : "POST /v1/responses\nWSL_IP:8642"
relay ..> abigail : "POST /v1/responses\nWSL_IP:8643"
relay ..> haley : "WSL_IP:8644"
relay ..> harvey : "WSL_IP:8645"
relay ..> penny : "WSL_IP:8646"
relay ..> sebastian : "WSL_IP:8647"

' WSL → Windows (via WIN_HOST_IP)
xiami ..> mcp_http : "MCP tool call\nWIN_HOST_IP:3000/mcp"
abigail ..> mcp_http : "MCP tool call\nWIN_HOST_IP:3000/mcp"

' External LLM (outbound from WSL)
xiami ..> llm_api : "HTTPS\n/api/v1/chat/completions"
abigail ..> llm_api : "HTTPS"
llm_api ..> xiami : "response"

' Health probes (Windows → WSL)
mcp_health ..> xiami : "health check\ncurl WSL_IP:8642/health"
mcp_health ..> abigail : "health check"

' Legend
rectangle "📋 地址映射" as legend {
  note right of legend
    **WIN_HOST_IP** (WSL default gateway)
    ≈ 192.168.48.1
    --
    **WSL_IP** (WSL eth0)
    ≈ 192.168.59.118
    --
    Auto-detected by
    scripts/detect_wsl_ips.sh
    at setup.bat / run.bat time
  end note
}

@enduml