# SmartNPC 本机配置 —— 复制为 .env 并按实际填写
#
#   cp .env.example .env
#
# .env 在 .gitignore；Taskfile 通过 `dotenv:` 自动加载，run.bat 也会读。
# 所有变量都有合理 fallback；只在偏离默认时才需要设。
#
# 详细分级见 docs/setup.md §3.2。下面注释里 [必看] / [按机器] /
# [自动] / [排障] 是优先级标签。
#
# ❌ 不要在这里写 LLM 的 api_key / base_url —— 那是写在
#    ~/.hermes/profiles/<npc>/config.yaml 的 model: 段（见 docs/setup.md §2.5）。
# ❌ 不要在这里写 Langfuse 凭证 —— 那是写在 WSL 的 ~/.hermes/.env（§2.7）。

# ── [必看] Stardew Valley 安装目录 ─────────────────────────────────
# 用于 smapi-mod 构建（csproj <GamePath>）、mod:install 拷贝目标，
# 以及 run.bat 第 6 步启动 StardewModdingAPI.exe。
# 留空时 ModBuildConfig 会自动探测大多数 Steam 默认位置；
# run.bat 没这个变量时回退到 D:\Stardew Valley。
# Linux 示例:   /home/<you>/.local/share/Steam/steamapps/common/Stardew Valley
# macOS 示例:   /Users/<you>/Library/Application Support/Steam/steamapps/common/Stardew Valley
# Windows 示例: C:\Program Files (x86)\Steam\steamapps\common\Stardew Valley
# SMARTNPC_GAME_PATH=

# ── [按机器] task.exe 路径（仅 run.bat 使用） ──────────────────────
# 默认 %USERPROFILE%\go\bin\task.exe。winget 装的可能在
# C:\Program Files\Task\task.exe。
# TASK_EXE=

# ── [按机器] WSL 发行版名（仅 run.bat 使用） ───────────────────────
# 默认 Ubuntu-22.04。`wsl -l -v` 查看真实名字。
# WSL_DISTRO=Ubuntu-22.04

# ── [按机器] dotnet 可执行路径 ─────────────────────────────────────
# 默认走 PATH 上的 `dotnet`。若不在 PATH 上再写绝对路径。
# DOTNET=dotnet

# ── [按机器] Hermes 启动哪些 NPC profile（run.bat 使用） ───────────
# 默认全开 6 个，每个 gateway ~300-500MB RAM、30-60s 冷启动。
# 想精简：SMARTNPC_ACTIVE_PROFILES=xiami,abigail
# 端口映射在 run.bat 里 hardcode：xiami=8642, abigail=8643,
# haley=8644, harvey=8645, penny=8646, sebastian=8647。
# SMARTNPC_ACTIVE_PROFILES=xiami,abigail,haley,harvey,penny,sebastian

# ── [按机器] Hermes Agent 模型配置 ────────────────────────────────
# 每个 profile 的 hermes/profiles/<npc>/.env 会配置实际 LLM url/key/model；
# config-overlay.yaml 通过 ${HERMES_AGENT_*} 引用这些值。
# 改完需要重新 sync profile 并重启 Hermes Gateway 才会生效。
# HERMES_AGENT_URL=http://api.anyone.woa.com/v1
# HERMES_AGENT_MODEL=deepseek-v4-flash

# ── [自动] WSL ↔ Windows IP（仅 run.bat 使用） ─────────────────────
# WIN_HOST_IP：从 WSL 看到的 Windows host IP（默认网关），用于
#   Hermes gateway 反向调 mcp HTTP。
# WSL_IP：从 Windows 看到的 WSL IP，用于 run.bat curl gateway /health。
# 二者由 scripts/detect_wsl_ips.sh 自动探测，通常无需设。
# 在 [cfg] 段看到 127.0.0.1 + [WARN] 时再来手填。
# WIN_HOST_IP=192.168.48.1
# WSL_IP=192.168.59.118
# smartnpc-mcp 读取 hermes/runtime-config.yaml 时会展开该变量；run.bat
# 默认把它设为 WSL_IP。手动启动 mcp 时可显式覆盖。
# SMARTNPC_HERMES_GATEWAY_HOST=192.168.59.118

# ── [自动] Hermes API Server 鉴权 key ──────────────────────────────
# 必须与每个 profile 的 config-overlay.yaml 里的 API_SERVER_KEY 一致。
# 默认 smartnpc-test-key 与仓库自带 overlay 匹配；改了 overlay 才需要改这个。
# SMARTNPC_HERMES_KEY=smartnpc-test-key

# ── [自动] SMAPI Mod ↔ smartnpc-mcp 的 ws 地址 ─────────────────────
# mod 侧由 config.json 控制（Host / Port）；mcp 侧用这个环境变量。
# SMARTNPC_WS_URL=ws://127.0.0.1:18745/ws

# ── [自动] smartnpc-mcp HTTP 模式端口 ──────────────────────────────
# 给跨主机 MCP 客户端（Claude Desktop / Hermes）用；默认 3000。
# SMARTNPC_HTTP_PORT=3000

# ── [排障] hermesrelay 调试 + 短窗口（默认全关） ───────────────────
# 架构原则：smartnpc-mcp 不持久化业务状态。conversation 短期记忆
# 由 Hermes profile 的 store + compression 处理；长期记忆走
# memory-policy skill。这里的开关只是 escape hatch。
#
#   SMARTNPC_RELAY_HISTORY_TURNS=0      默认 0（关）。设 >0 让 mcp
#       自管短窗口（player+npc 合计），把窗口拼到 input 头部。仅在
#       Hermes compression 失灵时打开作 escape hatch。
#   SMARTNPC_RELAY_STORE=1              默认 true（Hermes 持久化对话）。
#       设 0/false/no 关掉；通常和 HISTORY_TURNS>0 一起用，避免双重存储。
#   SMARTNPC_RELAY_TIMEOUT_MS=120000    单次 POST 超时；默认 120 秒。
#
# Debug payload trace（短期排障开）：
#   SMARTNPC_RELAY_DEBUG_PAYLOAD=1
#       开启 outbound/inbound 完整 body Debug 日志。
#   SMARTNPC_RELAY_PAYLOAD_LOG=<path>
#       上面的日志单独写到这个文件（JSON 行），不混进主 mcp.log。
#       run.bat 默认设为 <repo>\logs\payload_<时间戳>.log。
#       设这个变量会**隐式**开启 DEBUG_PAYLOAD。
# SMARTNPC_RELAY_DEBUG_PAYLOAD=1
# SMARTNPC_RELAY_PAYLOAD_LOG=D:\SmartNPC\logs\payload.log
