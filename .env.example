# SmartNPC — 环境配置
#
# 新用户快速开始：
#   1. copy .env.example .env
#   2. 填写下面「必填」区域的 4 个值
#   3. setup.bat
#   4. run.bat
#
# .env 已在 .gitignore。Taskfile 通过 dotenv: 自动加载。

# ══ 必填 ══════════════════════════════════════════════════════════

# Stardew Valley 安装路径（必须含 StardewModdingAPI.exe）
SMARTNPC_GAME_PATH=D:\Stardew Valley

# LLM 配置（Hermes Agent 使用的大模型后端）
HERMES_AGENT_URL=https://api.deepseek.com
HERMES_AGENT_API_KEY=sk-YOUR_KEY_HERE
HERMES_AGENT_MODEL=deepseek-v4-pro

# ══ 可选（有合理默认值，通常不需要改） ════════════════════════════

# MCP HTTP 端口（默认 3000）
# SMARTNPC_HTTP_PORT=3000

# 启动哪些 NPC（默认全部 6 个，逗号分隔）
# 可用值：xiami,abigail,haley,harvey,penny,sebastian
# SMARTNPC_ACTIVE_PROFILES=xiami,abigail,haley,harvey,penny,sebastian

# WSL 发行版名（wsl -l -v 查看，默认 Ubuntu-22.04）
# WSL_DISTRO=Ubuntu-22.04

# Hermes gateway 启动超时秒数（默认 90）
# HERMES_BOOT_TIMEOUT=90

# SMAPI Mod 与 MCP 之间的 WebSocket 地址（默认 ws://127.0.0.1:18745/ws）
# SMARTNPC_WS_URL=ws://127.0.0.1:18745/ws

# task.exe 路径（默认 %USERPROFILE%\go\bin\task.exe）
# TASK_EXE=

# ══ 高级可选（Langfuse 观测，不需要可忽略） ═══════════════════════

# HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# HERMES_LANGFUSE_SECRET_KEY=sk-lf-xxx
# HERMES_LANGFUSE_BASE_URL=http://langfuse:3000

# ══ 排障（出问题时打开） ══════════════════════════════════════════

# hermesrelay 打印完整 request/response body
# SMARTNPC_RELAY_DEBUG_PAYLOAD=1

# 对话历史窗口（默认 0 关闭，Hermes 自己管记忆）
# SMARTNPC_RELAY_HISTORY_TURNS=0

# Hermes store 持久化（默认 true）
# SMARTNPC_RELAY_STORE=1
